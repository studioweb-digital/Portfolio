  padding-left:max(16px, env(safe-area-inset-left, 0px));
  padding-right:max(16px, env(safe-area-inset-right, 0px));
  overflow-x:hidden;
}
a{color:inherit}
button{font:inherit;color:inherit;background:none;border:0;cursor:pointer}
:focus-visible{outline:1px solid var(--gold-2);outline-offset:3px}

.wrap{max-width:1280px;margin:0 auto;display:flex;flex-direction:column;gap:22px;padding-block:22px 40px}

/* header */
.top{display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap}
.brand{display:flex;align-items:baseline;gap:14px}
.brand b{font-family:var(--display);font-weight:500;font-size:22px;letter-spacing:.32em}
.brand span{font-size:11px;letter-spacing:.3em;text-transform:uppercase;color:var(--gold)}
.top-actions{display:flex;align-items:center;gap:10px}
.chip{font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:var(--muted)}
.ghost{display:inline-flex;align-items:center;gap:8px;height:36px;padding:0 14px;border:1px solid var(--line);font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--ivory);transition:border-color .3s,color .3s}
.ghost:hover{border-color:var(--gold);color:var(--gold-2)}
.ghost svg{width:14px;height:14px}

/* stage */
.stage{position:relative;width:min(100%, calc((100vh - 250px) * 16 / 9));min-width:min(100%, 320px);margin:0 auto;aspect-ratio:16/9;max-width:100%;background:#000;box-shadow:0 30px 80px -30px rgba(0,0,0,.9),0 0 0 1px var(--line)}
.slide{position:absolute;inset:0;opacity:0;visibility:hidden;transition:opacity .55s ease,visibility 0s linear .55s}
.slide.is-active{opacity:1;visibility:visible;transition:opacity .55s ease,visibility 0s}
.slide img{display:block;width:100%;height:100%;object-fit:contain;user-select:none;-webkit-user-drag:none}
.hot{position:absolute;display:block;border-radius:2px;transition:box-shadow .25s,background-color .25s}
.hot:hover,.hot:focus-visible{box-shadow:0 0 0 1px var(--gold-2);background:rgba(201,174,124,.08)}
.stage:fullscreen{width:100vw;height:100vh;aspect-ratio:auto;box-shadow:none}

/* controls */
.controls{display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap}
.label{display:flex;align-items:baseline;gap:14px;min-width:0}
.count{font-family:var(--display);font-size:26px;color:var(--gold-2);font-variant-numeric:tabular-nums;white-space:nowrap}
.count small{font-size:16px;color:var(--muted)}
.name{font-size:12px;letter-spacing:.24em;text-transform:uppercase;color:var(--ivory);overflow-wrap:anywhere}
.arrows{display:flex;gap:10px}
.arrow{width:46px;height:46px;border-radius:50%;border:1px solid var(--line);display:grid;place-items:center;transition:background-color .3s,border-color .3s,color .3s}
.arrow:hover:not(:disabled){background:var(--ivory);color:var(--ink);border-color:var(--ivory)}
.arrow:disabled{opacity:.3;cursor:default}
.arrow svg{width:18px;height:18px}

/* filmstrip */
.strip{display:grid;grid-template-columns:repeat(8,minmax(0,1fr));gap:10px}
.thumb{position:relative;aspect-ratio:16/9;max-width:100%;overflow:hidden;opacity:.5;outline:1px solid var(--line);transition:opacity .3s,outline-color .3s}
.thumb img{display:block;width:100%;height:100%;object-fit:cover}
.thumb:hover{opacity:.85}
.thumb[aria-current="true"]{opacity:1;outline-color:var(--gold)}
.hint{font-size:12px;color:var(--muted)}

/* projects */
.projects{border-top:1px solid var(--line);padding-top:26px;display:flex;flex-direction:column;gap:18px}
.projects h2{margin:0;font-family:var(--display);font-weight:400;font-size:30px;line-height:1.1}
.projects h2 em{color:var(--gold-2)}
.plist{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
.plink{display:flex;flex-direction:column;gap:4px;padding:18px 20px;background:var(--panel);border:1px solid var(--line);text-decoration:none;transition:border-color .3s,transform .4s}
.plink:hover{border-color:var(--gold);transform:translateY(-2px)}
.plink span{font-size:10.5px;letter-spacing:.24em;text-transform:uppercase;color:var(--gold)}
.plink b{font-family:var(--display);font-weight:500;font-size:24px}
.plink i{font-style:normal;font-size:12.5px;color:var(--muted);overflow-wrap:anywhere}
.foot{font-size:12px;color:var(--muted)}

