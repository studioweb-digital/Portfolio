.transcript ul{margin:10px 0 0;padding-left:18px;color:var(--muted);font-size:13.5px}
@media (max-width:760px){.transcript .tlist{grid-template-columns:1fr}}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
